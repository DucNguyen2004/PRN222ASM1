@page "{id}"
@model NguyenManhDucMVC.Pages.News.DetailsModel
@{
    ViewData["Title"] = Model.NewsArticle.NewsTitle;
}

<div class="container-fluid">
    <div class="row">
        @Html.Partial("_Sidebar")

        <main class="col-md-9 col-lg-10 ms-auto p-4" style="overflow-y: auto; height: 100vh;">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="card-title">@Model.NewsArticle.NewsTitle</h2>
                    <p class="text-muted">
                        <strong>Category:</strong> @(Model.NewsArticle.Category?.CategoryName ?? "Uncategorized")
                        <br>
                        <strong>Published:</strong> @Model.NewsArticle.CreatedDate?.ToString("dd MMMM, yyyy")
                    </p>
                    <hr>
                    <p class="card-text">@Html.Raw(Model.NewsArticle.NewsContent)</p>
                </div>
            </div>

            <div class="mt-4">
                <a asp-page="/News/Index" class="btn btn-secondary">Back to News</a>
            </div>
        </main>
    </div>
</div>